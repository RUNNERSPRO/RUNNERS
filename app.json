{
  "expo": {
    "name": "runners-pro",
    "slug": "runners-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080B10"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.veer.runnerspro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080B10"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDbQS5NKULHYSuU77bx3bjLEeNliZhgRdc"
        }
      }
    },
    "web": {
      "favicon": "./favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Runners Pro to use your location to track your runs in the background."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ed52e67d-d314-4a2a-ba69-07a582cfb792"
      }
    }
  }
}
